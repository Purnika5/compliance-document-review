# ==============================================================================
# Springer Capital - Compliance Document Review Platform
# Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Service Configuration
# ------------------------------------------------------------------------------
BACKEND_PORT=5000
NODE_ENV=development

# Database Settings (PostgreSQL)
# When running via Docker Compose, DB_HOST should be "postgres".
# When running locally on host machine, DB_HOST should be "localhost".
DB_HOST=postgres
DB_PORT=5432
DB_NAME=compliance_doc_review
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# JWT Authentication
JWT_SECRET=super-secret-compliance-jwt-key-change-in-production-2026!
JWT_EXPIRES_IN=7d

# File Upload Settings
UPLOAD_DIR=uploads/documents
MAX_FILE_SIZE_MB=25

# CORS Settings
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 2. Frontend Service Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
# Browser-accessible URL of the backend API
NEXT_PUBLIC_API_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 3. AI Service Configuration & Mock AI API
# ------------------------------------------------------------------------------
AI_PORT=8000
MOCK_AI_PORT=8001

# Gemini Free-Tier API Key (Optional when using Mock API)
GEMINI_API_KEY=your_gemini_free_tier_api_key_here

# Toggle mock AI service (true = route through local offline Mock API container)
USE_MOCK_AI=true
MOCK_AI_URL=http://mock-ai-api:8001

# ------------------------------------------------------------------------------
# 4. Week 3 Retrieval Service (pgvector / Data Engineering)
# ------------------------------------------------------------------------------
RETRIEVAL_SERVICE_URL=http://mock-ai-api:8001
RULE_RETRIEVAL_THRESHOLD=0.45
RULE_RETRIEVAL_TOP_K=5
PRECEDENT_SEARCH_THRESHOLD=0.50
PRECEDENT_SEARCH_TOP_K=5
