# Application Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=compliance_doc_review
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Supabase / Managed PostgreSQL Connection
# Paste your Supabase connection pooling URI here (Transaction mode, port 6543):
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ─────────────────────────────────────────────────────────────────────
# RENDER + SUPABASE DEPLOYMENT — REQUIRED ENVIRONMENT VARIABLES
# ─────────────────────────────────────────────────────────────────────
# The app auto-detects Supabase URLs and skips migrations automatically.
# For extra safety (recommended), set these in your Render service dashboard:
#
#   SKIP_MIGRATIONS=true       → Never run SQL migrations on startup (safest for production)
#   SKIP_SEEDING=true          → Never run mock data seeding on startup
#
# These two variables completely prevent any schema or data changes on deploy.
# Your Supabase data will NEVER be reset as long as these are set.
#
# To apply a new migration manually: run the SQL in Supabase SQL Editor directly.
# ─────────────────────────────────────────────────────────────────────
SKIP_MIGRATIONS=true
SKIP_SEEDING=true

# JWT Authentication
JWT_SECRET=super-secret-compliance-jwt-key-change-in-production-2026!
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=uploads/documents
MAX_FILE_SIZE_MB=25

# CORS Settings
CORS_ORIGIN=*

# Week 3 Retrieval & AI Service Integration
RETRIEVAL_SERVICE_URL=http://localhost:8001
RULE_RETRIEVAL_THRESHOLD=0.45
RULE_RETRIEVAL_TOP_K=5
PRECEDENT_SEARCH_THRESHOLD=0.50
PRECEDENT_SEARCH_TOP_K=5
