# Application Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL - local dev only)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=compliance_doc_review
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# ─────────────────────────────────────────────────────────────────────
# SUPABASE — CONNECTION (REQUIRED FOR PRODUCTION)
# ─────────────────────────────────────────────────────────────────────
# 1. Paste your Supabase Transaction Mode Pooler URI (port 6543):
#    Get it from: Supabase Dashboard → Project → Settings → Database → Connection pooling
# DATABASE_URL=postgresql://postgres.wpvchfdjirdxtcxorzjb:[YOUR-DB-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
#
# 2. Supabase API Keys (from Dashboard → Project → Settings → API Keys):
SUPABASE_URL=https://wpvchfdjirdxtcxorzjb.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_j4I8KlfXzwTBzrz1RiX7SA_acZDfM2o
# NEVER commit the secret key — set it in Render Dashboard only:
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_JWKS_URL=https://wpvchfdjirdxtcxorzjb.supabase.co/auth/v1/.well-known/jwks.json

# ─────────────────────────────────────────────────────────────────────
# MIGRATION BEHAVIOR
# ─────────────────────────────────────────────────────────────────────
# The app now auto-detects empty databases and runs migrations on first boot.
# On subsequent deploys, existing tables are detected → migrations skip automatically.
#
# SKIP_MIGRATIONS=true  → Force-skip even on empty DB (NOT recommended for first deploy)
# SKIP_SEEDING=true     → Never seed mock data (recommended for production)
SKIP_MIGRATIONS=true
SKIP_SEEDING=true

# JWT Authentication
JWT_SECRET=super-secret-compliance-jwt-key-change-in-production-2026!
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=uploads/documents
MAX_FILE_SIZE_MB=25

# CORS Settings
CORS_ORIGIN=*

# Week 3 Retrieval & AI Service Integration
RETRIEVAL_SERVICE_URL=http://localhost:8001
RULE_RETRIEVAL_THRESHOLD=0.45
RULE_RETRIEVAL_TOP_K=5
PRECEDENT_SEARCH_THRESHOLD=0.50
PRECEDENT_SEARCH_TOP_K=5

# Google Gemini AI
# GEMINI_API_KEY=your_gemini_api_key_here
