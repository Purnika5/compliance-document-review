# Application Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=compliance_doc_review
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Supabase / Managed PostgreSQL Connection (Optional)
# If using Supabase, paste your connection pooling URI or direct connection string:
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# SUPABASE_DB_URL=postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Existing Database & Migration Controls
# Automatically detects existing Supabase tables. Use these to explicitly bypass migrations and mock seeding:
# SKIP_MIGRATIONS=true
# SKIP_SEEDING=true
# SUPABASE_EXISTING_DB=true

# JWT Authentication
JWT_SECRET=super-secret-compliance-jwt-key-change-in-production-2026!
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=uploads/documents
MAX_FILE_SIZE_MB=25

# CORS Settings
CORS_ORIGIN=*

# Week 3 Retrieval & AI Service Integration
RETRIEVAL_SERVICE_URL=http://localhost:8001
RULE_RETRIEVAL_THRESHOLD=0.45
RULE_RETRIEVAL_TOP_K=5
PRECEDENT_SEARCH_THRESHOLD=0.50
PRECEDENT_SEARCH_TOP_K=5
