{
  "name": "springer-capital-compliance-backend",
  "version": "1.0.0",
  "description": "Express REST API Backend for Compliance Document Review Platform (Render Host)",
  "author": "Keith Lachica (https://github.com/keithlachica)",
  "repository": {
    "type": "git",
    "url": "https://github.com/keithlachica/compliance-document-review.git"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "ts-node-dev src/db/migrate.ts",
    "seed": "ts-node-dev src/db/seed.ts",
    "test": "jest --runInBand --detectOpenHandles",
    "test:pii-leakage": "jest --runInBand --detectOpenHandles tests/pii_leakage_gate.test.ts",
    "test:secrets": "jest --runInBand --detectOpenHandles tests/security_secrets.test.ts",
    "audit:masking": "python ../scripts/audit_masking_security.py"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/pdf-parse": "^1.1.5",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.1",
    "pg-mem": "3.0.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
